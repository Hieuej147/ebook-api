{
  "name": "@bookstore/thread-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev:express": "tsx examples/express-app/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:test:reset": "NODE_ENV=test node scripts/reset-test-db.mjs",
    "test:clean": "pnpm db:test:reset && vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ag-ui/client": "0.0.57",
    "@copilotkit/runtime": "1.63.1",
    "rxjs": "7.8.1"
  },
  "peerDependencies": {
    "@langchain/core": ">=1.0.0",
    "@langchain/langgraph": ">=1.0.0",
    "@langchain/langgraph-checkpoint": ">=1.0.0",
    "@langchain/langgraph-checkpoint-postgres": ">=1.0.0",
    "@langchain/langgraph-checkpoint-sqlite": ">=1.0.0",
    "better-sqlite3": ">=9.0.0",
    "pg": ">=8.0.0"
  },
  "peerDependenciesMeta": {
    "ioredis": { "optional": true },
    "@langchain/core": { "optional": true },
    "@langchain/langgraph": { "optional": true },
    "@langchain/langgraph-checkpoint": { "optional": true },
    "@langchain/langgraph-checkpoint-postgres": { "optional": true },
    "@langchain/langgraph-checkpoint-sqlite": { "optional": true },
    "better-sqlite3": { "optional": true },
    "pg": { "optional": true }
  },
  "devDependencies": {
    "@langchain/core": "^1.2.2",
    "@langchain/langgraph": "^1.4.7",
    "@langchain/langgraph-checkpoint": "^1.1.3",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.4",
    "@langchain/langgraph-checkpoint-sqlite": "^1.0.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "ioredis": "^5.10.0",
    "@types/pg": "^8.15.0",
    "better-sqlite3": "^12.9.0",
    "express": "^5.1.0",
    "pg": "^8.20.0",
    "tsx": "^4.21.0",
    "tsup": "^8.5.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
