// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client-js"
  // output   = "../generated/prisma"
  moduleFormat    = "cjs"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

enum Role {
  USER
  ADMIN
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum CustomerType {
  NORMAL
  PREMIUM
}

enum Status {
  DRAFT
  PUBLISHED
}

enum ConversationThreadStatus {
  IDLE
  RUNNING
  DELETING
}

enum AgentRunStatus {
  RUNNING
  COMPLETED
  ERROR
  STOPPED
}

enum ConversationMessageStatus {
  STREAMING
  COMPLETED
  ERROR
}

// enum WriteStyle {
//   INFORMATIVE
//   STORYTELLING
//   CASUAL 
//   PROFESSIONAL
//   HUMOROUS
// }

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  password     String
  firstName    String?
  lastName     String?
  role         Role         @default(USER)
  customerType CustomerType @default(NORMAL)
  refreshToken String?

  //Relations
  orders              Order[]
  carts               Cart[]
  payments            Payment[]
  usage               Usage?
  conversationThreads ConversationThread[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@map("users") // the name of the table
}

model Book {
  id          String     @id @default(uuid())
  title       String
  subtitle    String?
  author      String
  description String?
  price       Decimal    @db.Decimal(10, 2)
  stock       Int        @default(0)
  sku         String     @unique
  imageUrl    String?
  isActive    Boolean    @default(true)
  chapter     Chapters[]
  status      Status     @default(DRAFT)

  // Relations
  orderItems OrderItem[]
  cartItems  CartItem[]

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  // Timestamps

  createdAt DateTime                    @default(now())
  updatedAt DateTime                    @updatedAt
  deletedAt DateTime?
  embedding Unsupported("vector(768)")?

  @@index([sku])
  @@index([categoryId])
  @@map("books") // the name of the table
}

model Chapters {
  id            String  @id @default(uuid())
  bookId        String
  title         String
  description   String?
  content       String?
  chapterNumber Int
  book          Book    @relation(fields: [bookId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([chapterNumber])
  @@index([bookId])
  @@map("chapters")
}

model Category {
  id          String  @id @default(uuid())
  name        String
  description String?
  slug        String  @unique
  imageUrl    String?
  isActive    Boolean @default(true)
  books       Book[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([isActive])
  @@map("categories")
}

model OrderItem {
  id       String  @id @default(uuid())
  quantity Int
  price    Decimal @db.Decimal(10, 2)
  bookId   String
  book     Book    @relation(fields: [bookId], references: [id])

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([bookId])
  @@map("order_items")
}

model CartItem {
  id       String @id @default(uuid())
  quantity Int    @default(1)
  bookId   String
  book     Book   @relation(fields: [bookId], references: [id])

  cartId String
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, bookId])
  @@index([cartId])
  @@index([bookId])
  @@map("carts_items")
}

model Order {
  id          String      @id @default(uuid())
  orderNumber String      @unique @default(cuid())
  status      OrderStatus
  totalAmount Decimal     @db.Decimal(10, 2)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  cartId String?
  cart   Cart?   @relation(fields: [cartId], references: [id])

  shippingAddress String?

  orderItems OrderItem[]
  payment    Payment?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([orderNumber])
  @@index([status])
  @@map("orders")
}

model Cart {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  orders     Order[]
  checkedOut Boolean @default(false)

  cartItems CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("carts")
}

model Payment {
  id            String        @id @default(uuid())
  amount        Decimal       @db.Decimal(10, 2)
  status        PaymentStatus @default(PENDING)
  currency      String        @default("usd")
  paymentMethod String?
  transactionId String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([userId])
  @@index([transactionId])
  @@map("payments")
}

model Usage {
  userId String    @unique
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  key    String    @id @default(uuid())
  points Int       @default(10)
  expire DateTime?

  @@map("usages")
}

model ConversationThread {
  id         String                   @id
  userId     String
  agentId    String
  title      String                   @default("New conversation")
  status     ConversationThreadStatus @default(IDLE)
  archivedAt DateTime?
  createdAt  DateTime                 @default(now())
  updatedAt  DateTime                 @updatedAt

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  runs AgentRun[]
  messages ConversationMessage[]

  @@index([userId, agentId, archivedAt, updatedAt])
  @@index([agentId, updatedAt])
  @@map("conversation_threads")
}

model AgentRun {
  id         String         @id
  threadId   String
  agentId    String
  input      Json
  status     AgentRunStatus @default(RUNNING)
  startedAt  DateTime       @default(now())
  finishedAt DateTime?

  thread ConversationThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  events AgentEvent[]
  messages ConversationMessage[]

  @@index([threadId, startedAt])
  @@map("agent_runs")
}

model ConversationMessage {
  id        String                    @id
  threadId  String
  runId     String
  role      String
  content   String
  status    ConversationMessageStatus @default(STREAMING)
  createdAt DateTime                  @default(now())
  updatedAt DateTime                  @updatedAt

  thread ConversationThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  run    AgentRun           @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, id])
  @@index([threadId, createdAt])
  @@map("conversation_messages")
}

model AgentEvent {
  runId     String
  sequence  Int
  threadId  String
  event     Json
  createdAt DateTime @default(now())

  run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@id([runId, sequence])
  @@index([threadId, createdAt, sequence])
  @@map("agent_events")
}
